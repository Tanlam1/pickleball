rules_version = '2';

/* Dán toàn bộ nội dung file này vào:
   Firebase Console > Firestore Database > tab Rules > Publish

   Mô hình quyền: ai đăng nhập được (kể cả ẩn danh) VÀ biết mã phòng thì đọc/ghi được phòng đó.
   Phù hợp với nhóm chơi quen biết nhau. Muốn siết chặt hơn, xem phần cuối FIREBASE.md. */

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {

      // Mã phòng: 3–32 ký tự, chữ thường / số / gạch ngang
      function validId() {
        return roomId.matches('^[a-z0-9][a-z0-9-]{2,31}$');
      }

      // Chặn ghi rác: đúng bộ field, giới hạn kích thước
      function validData() {
        let d = request.resource.data;
        return d.keys().hasOnly(['rosters', 'sessions', 'updatedAt', 'updatedBy'])
            && d.rosters is list
            && d.rosters.size() <= 50
            && d.sessions is list
            && d.sessions.size() <= 200
            && d.updatedBy is string
            && d.updatedBy.size() <= 40
            && d.updatedAt == request.time;
      }

      allow read:           if request.auth != null && validId();
      allow create, update: if request.auth != null && validId() && validData();
      allow delete:         if false;
    }

    // Mọi đường dẫn khác: cấm
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
